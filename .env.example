# Copy to .env and adjust. Never commit the real .env file.

# Comma-separated list of frontend origins allowed to call the API (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paths (relative to the project root) of the trained artifacts
MODEL_PATH=credit_risk_model.pkl
THRESHOLD_PATH=best_threshold.pkl

LOG_LEVEL=INFO
