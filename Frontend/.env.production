# Used automatically by `npm run build` (production builds, e.g. on Render).
# Safe to commit: VITE_ values are public and end up in the browser bundle anyway.
# A variable set in the hosting dashboard overrides the value here.

# Base URL of the deployed FastAPI service (no trailing slash)
VITE_API_BASE_URL=https://loan-prediction-model-215x.onrender.com

# The free Render backend sleeps when idle and can take ~60s to wake up
VITE_REQUEST_TIMEOUT_MS=60000
